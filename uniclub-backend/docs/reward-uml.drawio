<mxfile host="app.diagrams.net" pages="5">
  <diagram id="class-diagram---view-rewards" name="Class Diagram - View Rewards">
    <mxGraphModel dx="3289" dy="1840" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection LR\n\nclass clubMembershipRoutes {\n  - router: Router\n  - rewardController: rewardController\n  + get(clubId, search, verifyToken, protect, requireClubMember, getRewards): Router\n  + get(clubId, rewardId, verifyToken, protect, requireClubMember, getRewardDetail): Router\n  + get(clubId, status, verifyToken, protect, requireClubMember, getMyRedemptionHistory): Router\n  + post(clubId, rewardId, verifyToken, protect, requireClubMember, redeemReward): Router\n}\n\nclass authMiddleware {\n  - secret: String\n  + verifyToken(req, res, next): void\n  + protect(allowedRoles): Middleware\n}\n\nclass clubAuthMiddleware {\n  - ClubMember: clubMemberModel\n  + requireClubMember(paramName): Middleware\n  - resolveClubId(req, paramName): ObjectId\n}\n\nclass rewardController {\n  - rewardService: rewardService\n  + getRewards(req, res, next): Promise~Response~\n  + getRewardDetail(req, res, next): Promise~Response~\n  + getMyRedemptionHistory(req, res, next): Promise~Response~\n  + redeemReward(req, res, next): Promise~Response~\n}\n\nclass rewardService {\n  - Club: clubModel\n  - ClubMember: clubMemberModel\n  - Reward: rewardModel\n  - RewardTransaction: rewardTransactionModel\n  + getMemberRewards(clubId, userId, search): Promise~Object~\n  + getMemberRewardDetail(clubId, rewardId, userId): Promise~Object~\n  + getMyRedemptionHistory(clubId, userId, status): Promise~Object~\n  + redeemReward(clubId, rewardId, userId): Promise~Object~\n  - validateId(id, fieldName): void\n  - getActiveMembership(clubId, userId): Promise~clubMemberModel~\n}\n\nclass errorUtil {\n  + getStatusError(message, statusCode): Error\n}\n\nclass clubModel {\n  + _id: ObjectId\n  + name: String\n  + status: String\n}\n\nclass clubMemberModel {\n  + _id: ObjectId\n  + club_id: ObjectId\n  + user_id: ObjectId\n  + role: String\n  + status: String\n  + reward_points: Number\n}\n\nclass rewardModel {\n  + _id: ObjectId\n  + club_id: ObjectId\n  + name: String\n  + description: String\n  + points_required: Number\n  + quantity: Number\n  + is_active: Boolean\n  + created_at: Date\n  + updated_at: Date\n}\n\nclass rewardTransactionModel {\n  + _id: ObjectId\n  + membership_id: ObjectId\n  + reward_id: ObjectId\n  + points_spent: Number\n  + status: Number\n  + created_at: Date\n  + updated_at: Date\n}\n\nclubMembershipRoutes --&gt; rewardController\nclubMembershipRoutes ..&gt; authMiddleware\nclubMembershipRoutes ..&gt; clubAuthMiddleware\n\nrewardController --&gt; rewardService\n\nclubAuthMiddleware ..&gt; clubMemberModel\nclubAuthMiddleware ..&gt; errorUtil\n\nrewardService ..&gt; clubModel\nrewardService ..&gt; clubMemberModel\nrewardService ..&gt; rewardModel\nrewardService ..&gt; rewardTransactionModel\nrewardService ..&gt; errorUtil\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="etWO2jAvocbQJ1IZgj3w-108">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
