        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n    actor member as Club Member\n    participant nav as :rewardNavigationBar\n    participant view as :redemptionHistoryView\n    participant route as :clubMembershipRoutes\n    participant controller as :rewardController\n    participant service as :rewardService\n    participant membershipModel as :clubMemberModel\n    participant transactionModel as :rewardTransactionModel\n    participant database as Database\n\n    member-&gt;&gt;nav: 1. clickRedemptionHistory()\n    activate nav\n    nav-&gt;&gt;view: 2. navigateToRedemptionHistory()\n    deactivate nav\n\n    activate view\n    view-&gt;&gt;route: 3. GET /redemption-history?status=\n    activate route\n\n    Note over route,controller: ref&lt;br/&gt;Authentication and Club-member authorization\n\n    route-&gt;&gt;controller: 4. getMyRedemptionHistory(req, res, next)\n    activate controller\n\n    controller-&gt;&gt;service: 5. getMyRedemptionHistory(clubId, userId, status)\n    activate service\n\n    service-&gt;&gt;service: 6. validateId(clubId)\n\n    service-&gt;&gt;membershipModel: 7. findOne({club_id, user_id, status: \&quot;active\&quot;})\n    activate membershipModel\n    membershipModel-&gt;&gt;database: 8. Query ClubMember record\n    activate database\n    database--&gt;&gt;membershipModel: 9. Return membership data\n    deactivate database\n    membershipModel--&gt;&gt;service: 10. Return membership object\n    deactivate membershipModel\n\n    opt status query is supplied\n        service-&gt;&gt;service: 11. Validate status: 0, 1, 2, or 3\n    end\n\n    alt Status is invalid\n        service-&gt;&gt;service: 12. Invalid status → throw 400 Bad Request\n        service--&gt;&gt;controller: 13. Return error\n        controller-&gt;&gt;route: 14. next(error)\n        route--&gt;&gt;view: 15. HTTP 400 Bad Request\n        view--&gt;&gt;member: 16. Show error message\n\n    else Status is valid or absent\n        service-&gt;&gt;transactionModel: 17. find({membership_id, status})&lt;br/&gt;sort({created_at: -1}).populate(\&quot;reward_id\&quot;)\n        activate transactionModel\n\n        transactionModel-&gt;&gt;database: 18. Query RewardTransaction records\n        activate database\n        database--&gt;&gt;transactionModel: 19. Return transaction history\n        deactivate database\n\n        transactionModel--&gt;&gt;service: 20. Return transactions\n        deactivate transactionModel\n\n        service--&gt;&gt;controller: 21. Return transaction list\n        deactivate service\n\n        controller--&gt;&gt;route: 22. 200 OK\n        deactivate controller\n\n        route--&gt;&gt;view: 23. Return redemption history response\n        deactivate route\n\n        view--&gt;&gt;member: 24. Render redemption history\n        deactivate view\n    end\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="c2qu5QwQojvO2WvtJNKk-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Club Member" mermaidId="n:member" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Club Member" id="c2qu5QwQojvO2WvtJNKk-2">
          <mxCell parent="c2qu5QwQojvO2WvtJNKk-1" style="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
